# clang-tidy resolves to an EMPTY check set without a config: it prints its
# usage and exits without reading a file, so a run that looks clean has analysed
# nothing. That is what this file is for (GHUB-0139). Three analysers are meant
# to cover this codebase and one of them was doing nothing at all, which is why
# eight review lanes reported findings in its territory by hand -- narrowing
# conversions, a signed char handed to <cctype>, integer overflow on restore,
# unguarded front() and pop_back().
#
# The set is chosen for defects rather than for style. This project's own
# conventions are held by CLAUDE.md and by review, not by a linter, so the
# readability- and modernize- families are left out: they would bury the
# findings that matter under hundreds that do not.
Checks: >
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-narrowing-conversions,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-slicing,
  misc-*,
  performance-*,
  -bugprone-easily-swappable-parameters,
  -misc-include-cleaner,
  -misc-no-recursion,
  -misc-non-private-member-variables-in-classes,
  -misc-use-anonymous-namespace,
  -misc-const-correctness,
  -misc-override-with-different-visibility,
  -misc-use-internal-linkage,
  -performance-enum-size

# The three above are switched off after MEASURING them, not on suspicion.
# Together they were 112 of the first run's 184 warnings and not one of them
# named a defect, so leaving them on would bury the twelve narrowing
# conversions and the nine signed-char conversions that this file exists to
# surface.
#
#   misc-const-correctness (65) asks for const on locals. A style preference,
#   and this project's conventions are held by CLAUDE.md and by review.
#
#   misc-override-with-different-visibility (28) is every view declaring
#   sizeHint and minimumSizeHint protected where QWidget has them public. That
#   is the deliberate shape of all fourteen views, and GHUB-0017 records why
#   the alternative -- opening those headers up -- was rejected.
#
#   performance-enum-size (19) asks for narrower underlying types. A
#   micro-optimisation on enums that are never stored in bulk.
#
# misc-use-internal-linkage is off for a different reason: it is WRONG here. It
# produced 203 warnings, and the ones checked name LOCAL VARIABLES -- a `blob`
# inside a saveState(), an `out` beside it -- which cannot be made static or
# moved into an anonymous namespace at all. A checker that cannot be acted on
# is worse than no checker, because every run has to re-triage it.

CheckOptions:
  # qint8 is Qt's `signed char`, and every use of it here is a small SIGNED
  # number read off a save stream -- a suit, a rank, a seat, a row. Each is
  # range-checked before it is used, and the check's own remedy would break
  # those guards: casting to unsigned char first turns a rejected -1 into 255
  # and walks it straight past the test above it.
  #
  # Narrowed rather than switched off, because the hazard the check exists for
  # is real and is a different shape -- a signed char handed to <cctype>, where
  # a negative value is undefined behaviour. Every such call in this codebase
  # (chessboard.cpp's toupper, tolower and isupper) already casts to unsigned
  # char, and this keeps the next one that forgets reported.
  #
  # Both spellings of the option: bugprone-signed-char-misuse and cert-str34-c
  # are aliases that each carry their own copy, and setting one leaves the
  # other reporting. Confirmed against `clang-tidy --dump-config`, which is
  # also where the exact key is -- an older name for it is missing an `e` and
  # is silently ignored rather than refused.
  bugprone-signed-char-misuse.CharTypedefsToIgnore: 'qint8'
  cert-str34-c.CharTypedefsToIgnore: 'qint8'

  # main.cpp writes its CLI diagnostics with fprintf and discards the byte
  # count, which is what every program does with a message to stderr. Each of
  # those calls says so with a (void) cast rather than being excused wholesale,
  # so the check keeps reporting a return value dropped anywhere it matters.
  cert-err33-c.AllowCastToVoid: true

# Qt's own headers are not ours to fix, and AUTOMOC's generated sources are not
# written by anybody. Only what is in src/ is answerable here.
HeaderFilterRegex: 'src/.*\.h$'
ExcludeHeaderFilterRegex: '.*_autogen.*'

# Enforced from 2026-09-04 (GHUB-0170), the backlog having been worked through
# to zero. Until then this was empty on purpose: promoting findings to errors
# while a backlog stood would have failed a build for something nobody had
# triaged.
#
# What this does and does not bind. Nothing in CI runs clang-tidy, so it binds a
# manual `run-clang-tidy -p build $(git ls-files 'src/*.cpp')` and nothing else
# -- it does not gate a push and cannot redden a workflow. It also means a
# clang-tidy newer than the one this was tuned against may fail on checks that
# did not exist here; that is the intended cost, and the answer is to triage the
# new finding rather than to empty this line.
WarningsAsErrors: '*'
FormatStyle: none
