#!/usr/bin/env bash
# Runs the local CI pipeline before every push, so a red build is found here
# rather than on GitHub.
#
# Enable it once per clone:
#     git config core.hooksPath .githooks
#
# A documentation-only push runs the workflow linters and stops — there is no
# code for the compiler to have an opinion about. Anything touching code,
# CMake or a workflow runs the full local pipeline.
#
# Emergency bypass: SKIP_LOCAL_CI=1 git push
# Use it when you mean to; it is not the default for a reason.

set -uo pipefail

if [ "${SKIP_LOCAL_CI:-}" = "1" ]; then
    echo "pre-push: SKIP_LOCAL_CI=1 — local CI deliberately skipped."
    exit 0
fi

CI=scripts/local-ci.sh
[ -x "$CI" ] || { echo "pre-push: $CI is missing or not executable"; exit 1; }

# git feeds "<local ref> <local sha> <remote ref> <remote sha>" on stdin, ONE
# LINE PER REF. Accumulate the changed files across all of them: a loop that
# overwrote a single range let the last ref decide the whole push, and
# `git push --follow-tags` sends the tag last — which is how a release push
# came out looking like a documentation change (GHUB-0027).
ZERO=0000000000000000000000000000000000000000
CHANGED=""
PUSHING=0
while read -r _localref localsha _remoteref remotesha; do
    [ "$localsha" = "$ZERO" ] && continue          # a branch or tag deletion
    PUSHING=1
    if [ "$remotesha" = "$ZERO" ]; then
        # A ref the remote has never seen — a new branch, or the tag half of
        # a --follow-tags push. NOT `git diff <sha>`: that compares the commit
        # against the WORKING TREE, so on a clean checkout it reports nothing
        # changed at all. Ask instead for the commits this ref adds on top of
        # everything the remote already has.
        files=$(git log --name-only --pretty=format: "$localsha" --not --remotes 2>/dev/null)
    else
        files=$(git diff --name-only "$remotesha" "$localsha" 2>/dev/null)
    fi
    CHANGED="$CHANGED
$files"
done

if [ "$PUSHING" = 0 ]; then
    echo "pre-push: nothing to check (deletion or empty push)."
    exit 0
fi

# Docs-only if nothing outside these paths changed. Deliberately strict: a
# CMakeLists or workflow edit is NOT documentation, however small.
CODE=$(printf '%s\n' "$CHANGED" | grep -Ev '(^$|\.md$|^docs/|^LICENSE$|^\.gitignore$|^packaging/licenses/)' || true)

if [ -z "$CODE" ]; then
    echo "pre-push: nothing outside the docs changed — running the workflow linters only."
    exec "$CI" --lint
fi

echo "pre-push: code changed, running the full local pipeline:"
printf '%s\n' "$CODE" | sed 's/^/    /'
exec "$CI"
