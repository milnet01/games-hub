---
# The one set of yamllint settings for this repository. ci.yml's lint job and
# scripts/local-ci.sh both run a bare `yamllint`, which reads this file, so the
# two cannot come to disagree (GHUB-0051).
extends: default
rules:
  line-length:
    max: 100
  truthy:
    check-keys: false
  # FUNDING.yml is read line by line by two hand parsers -- cmake/funding.cmake
  # and the donate check in tests/uitest.cpp -- and neither expects a `---`.
  # The uitest one counted it as a fourth link (GHUB-0055).
  document-start:
    ignore: |
      .github/FUNDING.yml
